{
  "name": "oxlint-config-raccoon",
  "version": "10.0.6",
  "description": "Artem Sapegin’s Oxlint and Oxfmt config",
  "keywords": [
    "oxfmt",
    "oxfmtconfig",
    "oxlint",
    "oxlintconfig"
  ],
  "homepage": "https://github.com/sapegin/oxlint-config-raccoon",
  "bugs": {
    "url": "https://github.com/sapegin/oxlint-config-raccoon/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Artem Sapegin",
    "url": "https://sapegin.me/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapegin/oxlint-config-raccoon.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./base": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./typescript": {
      "types": "./dist/typescript.d.ts",
      "default": "./dist/typescript.js"
    },
    "./typescript-react": {
      "types": "./dist/typescript-react.d.ts",
      "default": "./dist/typescript-react.js"
    },
    "./typescript-react-tailwind": {
      "types": "./dist/typescript-react-tailwind.d.ts",
      "default": "./dist/typescript-react-tailwind.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./dist/oxfmt.js"
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "pretest": "npm run build",
    "test": "oxlint && vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware --fix",
    "format": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tailwindcss": "0.8.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "peerDependencies": {
    "oxfmt": ">=0.51",
    "oxlint": ">=1.66",
    "oxlint-tailwindcss": ">=0.8",
    "oxlint-tsgolint": ">=0.23"
  },
  "peerDependenciesMeta": {
    "oxlint-tailwindcss": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
